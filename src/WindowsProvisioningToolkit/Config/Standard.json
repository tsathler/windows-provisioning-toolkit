      "RequireInternet": true
    },
    "Execution": {
      "AllowAutomaticReboot": false,
      "StopOnHealthFailure": true,
      "ContinueOnWarning": true
    }
  },
  "HealthCheck": {
    "MinimumMemoryGB": 8,
